<!--
  npx cap add ios 실행 후 생성되는
  ios/App/App/Info.plist 파일의 <dict> 안에 아래 키들을 추가하세요.
  (Xcode에서 Info.plist 열어서 Source Code 보기로 붙여넣으면 편합니다)
-->

<!-- 세로/가로 모두 지원 (아이패드에서 특히 중요) -->
<key>UISupportedInterfaceOrientations</key>
<array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
</array>
<key>UISupportedInterfaceOrientations~ipad</key>
<array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
</array>

<!-- 외부 웹뷰(구글 스프레드시트 embed 등)를 위한 임의 로드 허용 필요 없음:
     이 앱은 로컬 www 번들 + fetch(https)만 쓰므로 ATS 예외는 필요 없습니다.
     혹시 특정 도메인에서 http(비암호화) 리소스를 쓰게 되면 그때만 예외 추가하세요. -->

<!-- 앱이 아이패드에서도 잘 보이도록 최소 지원 -->
<key>UIRequiresFullScreen</key>
<false/>
